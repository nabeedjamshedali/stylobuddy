{
  "enabled": true,
  "features_dir": "docs/features",
  "handoffs_dir": ".memory/handoffs",
  "code_paths": [
    "lib"
  ],
  "code_exempt": [
    "/lib/main.dart",
    "/lib/app.dart",
    "firebase_options.dart",
    ".g.dart",
    ".freezed.dart",
    "/generated/",
    "/l10n/"
  ],
  "test_paths": [
    "test"
  ],
  "boundaries": [
    {
      "name": "UI has no data access",
      "guarded_paths": [
        "lib/features/auth/view",
        "lib/features/auth/widgets",
        "lib/features/builder/view",
        "lib/features/builder/widgets",
        "lib/features/calendar/view",
        "lib/features/calendar/widgets",
        "lib/features/home/view",
        "lib/features/home/widgets",
        "lib/features/insights/view",
        "lib/features/insights/widgets",
        "lib/features/matching/view",
        "lib/features/matching/widgets",
        "lib/features/onboarding/view",
        "lib/features/onboarding/widgets",
        "lib/features/packing/view",
        "lib/features/packing/widgets",
        "lib/features/profile/view",
        "lib/features/profile/widgets",
        "lib/features/saved/view",
        "lib/features/saved/widgets",
        "lib/features/shopping/view",
        "lib/features/shopping/widgets",
        "lib/features/stylist/view",
        "lib/features/stylist/widgets",
        "lib/features/wardrobe/view",
        "lib/features/wardrobe/widgets",
        "lib/shared/widgets"
      ],
      "extensions": [
        ".dart"
      ],
      "forbidden": [
        {
          "pattern": "^\\s*import\\s+'package:(cloud_firestore|firebase_auth|firebase_storage|supabase_flutter|purchases_flutter|firebase_remote_config)/",
          "reason": "views and widgets are UI only; backend SDKs are used from repositories"
        },
        {
          "pattern": "^\\s*import\\s+'[^']*/repository/[^']*';",
          "reason": "widgets must reach data through a Cubit, never a repository"
        }
      ],
      "fix": "Move the call into the feature's repository, expose it through the feature Cubit, and render Cubit state in the widget (see .claude/agents/project-hygiene.md)."
    },
    {
      "name": "No Firebase Storage",
      "guarded_paths": [
        "lib"
      ],
      "extensions": [
        ".dart"
      ],
      "forbidden": [
        {
          "pattern": "^\\s*import\\s+'package:firebase_storage/",
          "reason": "all image/file storage goes through Supabase Storage"
        }
      ],
      "fix": "Upload with supabase_flutter Storage (bucket user-uploads/{uid}/...) and save the URL on the Firestore document."
    },
    {
      "name": "Cubit-only state",
      "guarded_paths": [
        "lib"
      ],
      "extensions": [
        ".dart"
      ],
      "forbidden": [
        {
          "pattern": "^\\s*import\\s+'package:(provider|riverpod|flutter_riverpod|hooks_riverpod|get|freezed_annotation)/",
          "reason": "state management is flutter_bloc Cubit with plain state classes; no other state managers or Freezed"
        },
        {
          "pattern": "\\bextends\\s+Bloc<",
          "reason": "use Cubit, not full Bloc"
        }
      ],
      "fix": "Use a Cubit with a plain State class and hand-written copyWith (see .claude/agents/tech-stack.md)."
    }
  ]
}
